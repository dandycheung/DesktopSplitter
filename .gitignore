# Build output
[Bb]in/
[Oo]bj/
x64/
x86/
[Dd]ebug/
[Rr]elease/
*.log
*.tlog
*.pdb
*.ilk
*.exp

# VS
.vs/
*.user
*.suo
ipch/
*.aps
*.VC.db
*.VC.opendb

# Version artefacts generated by build.ps1 from the root VERSION file.
# VERSION itself IS tracked - it is the source of truth.
build/generated/

# Driver signing artifacts
*.cer
*.pfx
*.cat.bak

# Driver package staged into the setup program at build time (copies of the
# driver build output - regenerated by installer\setup\stage-payload.ps1)
installer/setup/payload/

# Native C++ app local build tree (OutDir / IntDir)
app-native/build/

# One-off generator / fix / probe scratch from the native rewrite
# (not part of the build; the files stay on disk)
app-native/_gen_*.py
app-native/_fix_*.py
app-native/_patch_*.py
app-native/_*.py
app-native/_scroll_fns.cpp
app-native/_probe/

# Local probe copies used during the rewrite (not product source)
_probe/
